# LangChain LLM Configuration
# Copy this file to .env and fill in your values

# Default preset is deepseek-v4-pro.
# Switchable presets:
# deepseek-v4-pro, deepseek-v4-flash, gemini-3.0-pro, gpt-5.5, qwen3.6-plus, glm-5.1
LLM_MODEL_PRESET=deepseek-v4-pro
LLM_PROVIDER=
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL_NAME=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1
LLM_ENABLE_REMOTE=true
LOG_LEVEL=INFO

# Provider-specific keys can be used instead of LLM_API_KEY.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
DASHSCOPE_API_KEY=
GLM_API_KEY=
ZHIPU_API_KEY=

# Optional overrides. Leave blank to use the preset values.
# LLM_API_BASE=https://api.deepseek.com
# LLM_MODEL_NAME=deepseek-v4-pro

# Legacy OpenAI-compatible names are still supported.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=

# Database URL (default: SQLite)
DATABASE_URL=sqlite:///./resume_coach.db
# For pgvector:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/career_agent

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_ENABLE_REMOTE=true

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
